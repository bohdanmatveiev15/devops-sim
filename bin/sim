#!/usr/bin/env bash
#
# sim - work-time tracker for the FinSim simulation.
# Requires bash 4.2+ and GNU date. Data lives in ~/.devops-sim/.
# Exit codes: 0 success, 1 wrong usage, 2 state error.

# A fixed locale keeps weekday names in English and decimals printed with a dot.
export LC_ALL=C

SIM_DIR="$HOME/.devops-sim"
CONFIG_FILE="$SIM_DIR/config"
WORKLOG_FILE="$SIM_DIR/worklog.csv"
SESSION_FILE="$SIM_DIR/session"
DAYOFF_FILE="$SIM_DIR/dayoffs"
STANDUP_FILE="$SIM_DIR/last_standup"

WORKLOG_HEADER="date,start,end,minutes,note"
SECONDS_PER_DAY=86400
DAYS_PER_SPRINT=5
DEFAULT_FOCUS_MINUTES=50

die_usage() {
    echo "Usage: sim $1" >&2
    exit 1
}

die_state() {
    echo "$1" >&2
    exit 2
}

# --- Dates ---------------------------------------------------------------

is_valid_date() {
    [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] &&
        [ "$(date -u -d "$1" +%F 2>/dev/null)" = "$1" ]
}

clock_time() {
    date -d "@$1" +%H:%M
}

date_of_epoch() {
    date -d "@$1" +%F
}

# Calendar arithmetic runs in UTC, where every day is exactly 24 hours long.
add_days() {
    local base
    base=$(date -u -d "$1" +%s)
    date -u -d "@$((base + $2 * SECONDS_PER_DAY))" +%F
}

week_start() {
    local weekday
    weekday=$(date -u -d "$TODAY" +%u)
    add_days "$TODAY" "$((1 - weekday))"
}

is_dayoff() {
    [ -f "$DAYOFF_FILE" ] && grep -qx "$1" "$DAYOFF_FILE"
}

# --- Session state ------------------------------------------------------

# The session file holds: <start epoch> <paused seconds> <pause start epoch, 0 if running>
load_session() {
    [ -f "$SESSION_FILE" ] || return 1
    read -r SESSION_START SESSION_PAUSED SESSION_PAUSE_START <"$SESSION_FILE"
}

save_session() {
    printf '%s %s %s\n' "$1" "$2" "$3" >"$SESSION_FILE.tmp" &&
        mv "$SESSION_FILE.tmp" "$SESSION_FILE" ||
        die_state "Cannot write $SESSION_FILE"
}

# Prints the worked seconds of the loaded session up to the epoch in $1.
session_worked_seconds() {
    local paused=$SESSION_PAUSED
    if [ "$SESSION_PAUSE_START" -gt 0 ]; then
        paused=$((paused + $1 - SESSION_PAUSE_START))
    fi
    echo "$(($1 - SESSION_START - paused))"
}

# Minutes worked on a date. A session belongs to the date on which it started.
minutes_on() {
    local day=$1 total=0
    if [ -f "$WORKLOG_FILE" ]; then
        # The note is the last column, so commas inside it cannot shift these fields.
        total=$(awk -F, -v day="$day" '$1 == day { sum += $4 } END { print sum + 0 }' "$WORKLOG_FILE")
    fi
    if load_session && [ "$(date_of_epoch "$SESSION_START")" = "$day" ]; then
        total=$((total + $(session_worked_seconds "$(date +%s)") / 60))
    fi
    echo "$total"
}

minutes_this_week() {
    local monday offset total=0
    monday=$(week_start)
    for offset in 0 1 2 3 4 5 6; do
        total=$((total + $(minutes_on "$(add_days "$monday" "$offset")")))
    done
    echo "$total"
}

to_hours() {
    awk -v minutes="$1" 'BEGIN { printf "%.1f", minutes / 60 }'
}

csv_escape() {
    local value=$1 doubled_quote='""'
    value=${value//$'\r'/ }
    value=${value//$'\n'/ }
    case $value in
        *,* | *\"*)
            value=${value//\"/$doubled_quote}
            value="\"$value\""
            ;;
    esac
    printf '%s' "$value"
}

# --- Simulation calendar ------------------------------------------------

load_config() {
    [ -f "$CONFIG_FILE" ] || return 1
    START_DATE=$(sed -n 's/^START_DATE=//p' "$CONFIG_FILE" | head -n 1)
    is_valid_date "$START_DATE"
}

# Counts working days from the start date through today, without days off.
simulation_day() {
    local first last day timestamp count=0
    local -a dayoffs=()
    first=$(($(date -u -d "$START_DATE" +%s) / SECONDS_PER_DAY))
    last=$(($(date -u -d "$TODAY" +%s) / SECONDS_PER_DAY))

    if [ -s "$DAYOFF_FILE" ]; then
        while read -r timestamp; do
            dayoffs[$((timestamp / SECONDS_PER_DAY))]=1
        done < <(date -u -f "$DAYOFF_FILE" +%s)
    fi

    for ((day = first; day <= last; day++)); do
        # Day 0 of the epoch was a Thursday, so this gives 0 for Monday.
        if [ $(((day + 3) % 7)) -lt 5 ] && [ -z "${dayoffs[$day]}" ]; then
            count=$((count + 1))
        fi
    done
    echo "$count"
}

commits_since() {
    git log --oneline --no-decorate --since="$(date -d "@$1" '+%F %T')" 2>/dev/null
}

open_tickets() {
    local root file status
    root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
    for file in "$root"/tickets/OPS-*.md; do
        [ -f "$file" ] || continue
        status=$(sed -n 's/^[[:space:]]*Status:[[:space:]]*//p' "$file" | head -n 1 | tr -d '\r' |
            sed 's/[[:space:]]*$//')
        if [ "$status" != "Done" ]; then
            echo "tickets/${file##*/}"
        fi
    done | sort -V
}

print_list() {
    if [ -n "$2" ]; then
        echo "$1"
        echo "$2"
    else
        echo "$1 none"
    fi
}

# --- Commands -----------------------------------------------------------

cmd_init() {
    [ $# -eq 0 ] || die_usage "init"
    local input start_date
    read -r -p "Simulation start date (YYYY-MM-DD) [$TODAY]: " input
    start_date=${input:-$TODAY}
    is_valid_date "$start_date" || die_usage "init (the date must be a real YYYY-MM-DD date)"
    echo "START_DATE=$start_date" >"$CONFIG_FILE" || die_state "Cannot write $CONFIG_FILE"
    echo "Simulation start date: $start_date"
}

cmd_start() {
    [ $# -eq 0 ] || die_usage "start"
    if load_session; then
        die_state "Session already running since $(clock_time "$SESSION_START")"
    fi
    local now
    now=$(date +%s)
    save_session "$now" 0 0
    echo "Session started at $(clock_time "$now")"
}

cmd_stop() {
    [ $# -le 1 ] || die_usage 'stop ["note"]'
    load_session || die_state "No active session"
    local now minutes
    now=$(date +%s)
    minutes=$(($(session_worked_seconds "$now") / 60))

    if [ ! -s "$WORKLOG_FILE" ]; then
        echo "$WORKLOG_HEADER" >"$WORKLOG_FILE" || die_state "Cannot write $WORKLOG_FILE"
    fi
    printf '%s,%s,%s,%s,%s\n' "$(date_of_epoch "$SESSION_START")" "$(clock_time "$SESSION_START")" \
        "$(clock_time "$now")" "$minutes" "$(csv_escape "${1:-}")" >>"$WORKLOG_FILE" ||
        die_state "Cannot write $WORKLOG_FILE"

    rm -f "$SESSION_FILE"
    echo "Session saved: $minutes min"
}

cmd_pause() {
    [ $# -eq 0 ] || die_usage "pause"
    load_session || die_state "No active session"
    if [ "$SESSION_PAUSE_START" -gt 0 ]; then
        die_state "Session already paused since $(clock_time "$SESSION_PAUSE_START")"
    fi
    local now
    now=$(date +%s)
    save_session "$SESSION_START" "$SESSION_PAUSED" "$now"
    echo "Session paused at $(clock_time "$now")"
}

cmd_resume() {
    [ $# -eq 0 ] || die_usage "resume"
    load_session || die_state "No active session"
    if [ "$SESSION_PAUSE_START" -eq 0 ]; then
        die_state "Session is not paused"
    fi
    local now pause_seconds
    now=$(date +%s)
    pause_seconds=$((now - SESSION_PAUSE_START))
    save_session "$SESSION_START" "$((SESSION_PAUSED + pause_seconds))" 0
    echo "Session resumed after $((pause_seconds / 60)) min pause"
}

cmd_status() {
    [ $# -eq 0 ] || die_usage "status"
    if load_session; then
        local worked
        worked=$(($(session_worked_seconds "$(date +%s)") / 60))
        if [ "$SESSION_PAUSE_START" -gt 0 ]; then
            echo "Session: paused since $(clock_time "$SESSION_PAUSE_START"), started $(clock_time "$SESSION_START"), $worked min worked"
        else
            echo "Session: running since $(clock_time "$SESSION_START"), $worked min worked"
        fi
    else
        echo "Session: none"
    fi
    echo "Worked today: $(minutes_on "$TODAY") min"
}

notify_windows() {
    command -v powershell.exe >/dev/null 2>&1 || return 1
    powershell.exe -NoProfile -NonInteractive -Command "
        Add-Type -AssemblyName System.Windows.Forms, System.Drawing;
        \$icon = New-Object System.Windows.Forms.NotifyIcon;
        \$icon.Icon = [System.Drawing.SystemIcons]::Information;
        \$icon.Visible = \$true;
        \$icon.ShowBalloonTip(10000, 'FinSim focus', '$1', 'Info');
        [console]::Beep(880, 300);
        [console]::Beep(880, 300);
        [console]::Beep(1175, 500);
        Start-Sleep -Seconds 5;
        \$icon.Dispose()" >/dev/null 2>&1
}

cmd_focus() {
    [ $# -le 1 ] || die_usage "focus [minutes]"
    local minutes=${1:-$DEFAULT_FOCUS_MINUTES}
    [[ $minutes =~ ^[1-9][0-9]*$ ]] || die_usage "focus [minutes] (minutes must be a positive integer)"

    local seconds=$((minutes * 60))
    echo "Focus started: $minutes min, until $(clock_time "$(($(date +%s) + seconds))"). Press Ctrl+C to cancel."
    sleep "$seconds"
    notify_windows "Focus finished: $minutes min"
    echo "Focus finished: $minutes min"
}

cmd_dayoff() {
    [ $# -le 1 ] || die_usage "dayoff [YYYY-MM-DD]"
    local day=${1:-$TODAY}
    is_valid_date "$day" || die_usage "dayoff [YYYY-MM-DD]"
    if is_dayoff "$day"; then
        echo "Day off already marked: $day"
        return 0
    fi
    echo "$day" >>"$DAYOFF_FILE" || die_state "Cannot write $DAYOFF_FILE"
    echo "Day off marked: $day"
}

report_today() {
    local minutes
    minutes=$(minutes_on "$TODAY")
    echo "Report for $TODAY ($(date -u -d "$TODAY" +%A))"
    echo "Total: $(to_hours "$minutes") h ($minutes min)"
}

report_week() {
    local monday offset day minutes label total=0
    monday=$(week_start)
    echo "Week $monday .. $(add_days "$monday" 6)"
    for offset in 0 1 2 3 4 5 6; do
        day=$(add_days "$monday" "$offset")
        minutes=$(minutes_on "$day")
        total=$((total + minutes))
        label=""
        if is_dayoff "$day"; then
            label=" (day off)"
        fi
        printf '%s %s %5s h%s\n' "$(date -u -d "$day" +%a)" "$day" "$(to_hours "$minutes")" "$label"
    done
    echo "Total: $(to_hours "$total") h ($total min)"
}

cmd_report() {
    [ $# -le 1 ] || die_usage "report [today|week]"
    case ${1:-today} in
        today) report_today ;;
        week) report_week ;;
        *) die_usage "report [today|week]" ;;
    esac
}

cmd_standup() {
    [ $# -eq 0 ] || die_usage "standup"
    load_config || die_state "Simulation is not initialized. Run: sim init"

    local since day sprint sprint_day
    if [ -s "$STANDUP_FILE" ]; then
        since=$(cat "$STANDUP_FILE")
    else
        since=$(date -d "$START_DATE" +%s)
    fi

    day=$(simulation_day)
    sprint=1
    sprint_day=0
    if [ "$day" -gt 0 ]; then
        sprint=$(((day - 1) / DAYS_PER_SPRINT + 1))
        sprint_day=$(((day - 1) % DAYS_PER_SPRINT + 1))
    fi

    echo "=== STANDUP ==="
    echo "Date: $TODAY ($(date -u -d "$TODAY" +%A))"
    echo "Simulation day: $day"
    echo "Sprint: $sprint, day $sprint_day of $DAYS_PER_SPRINT"
    echo "Hours today: $(to_hours "$(minutes_on "$TODAY")") | This week: $(to_hours "$(minutes_this_week)")"
    print_list "Commits since last standup:" "$(commits_since "$since")"
    print_list "Open tickets:" "$(open_tickets)"
    echo "==============="

    date +%s >"$STANDUP_FILE" || die_state "Cannot write $STANDUP_FILE"
}

print_help() {
    cat <<'EOF'
sim - work-time tracker for the FinSim simulation

Usage: sim <command> [arguments]

Commands:
  init                  Set the simulation start date
  start                 Start a work session
  stop ["note"]         Stop the session and save it to the worklog
  pause                 Pause the session; paused time is not counted
  resume                Resume a paused session
  status                Show the session state and minutes worked today
  focus [minutes]       Run a focus timer (default: 50 minutes)
  dayoff [YYYY-MM-DD]   Mark a day off (default: today)
  report [today|week]   Show hours for today or for this week (default: today)
  standup               Print a standup block ready to paste into chat
  help                  Show this help

Exit codes: 0 success, 1 wrong usage, 2 state error
EOF
}

cmd_help() {
    [ $# -eq 0 ] || die_usage "help"
    print_help
}

main() {
    if [ $# -eq 0 ]; then
        print_help >&2
        exit 1
    fi

    mkdir -p "$SIM_DIR" || die_state "Cannot create $SIM_DIR"
    TODAY=$(date +%F)

    local command=$1
    shift
    case $command in
        init | start | stop | pause | resume | status | focus | dayoff | report | standup | help)
            "cmd_$command" "$@"
            ;;
        *)
            print_help >&2
            exit 1
            ;;
    esac
}

main "$@"
