#!/usr/bin/env bash
#
# sim - work-time tracker for the FinSim simulation.
# Requires bash 4.2+ and GNU date. Data lives in $SIM_HOME (default ~/.devops-sim/).
# Exit codes: 0 success, 1 wrong usage, 2 state error.

# A fixed locale keeps weekday names in English and decimals printed with a dot.
export LC_ALL=C

SIM_DIR="${SIM_HOME:-$HOME/.devops-sim}"
CONFIG_FILE="$SIM_DIR/config"
WORKLOG_FILE="$SIM_DIR/worklog.csv"
SESSION_FILE="$SIM_DIR/session"
DAYOFF_FILE="$SIM_DIR/dayoffs"
STANDUP_FILE="$SIM_DIR/last_standup"
HEARTBEAT_FILE="$SIM_DIR/heartbeat"
HEARTBEAT_PID_FILE="$SIM_DIR/heartbeat.pid"
# One simulation day per line, in order: <real date> <work|off>
SIMDAYS_FILE="$SIM_DIR/simdays"

WORKLOG_HEADER="date,start,end,minutes,note"
SECONDS_PER_DAY=86400
DAYS_PER_SPRINT=5
DEFAULT_FOCUS_MINUTES=50
HEARTBEAT_SECONDS="${SIM_TEST_HEARTBEAT_SECONDS:-60}"
# A session closes by itself after this long without terminal input.
IDLE_CLOSE_SECONDS="${SIM_TEST_IDLE_CLOSE_SECONDS:-1800}"
# Terminal devices whose last input time counts as activity.
PTS_DIR="${SIM_TEST_PTS_DIR:-/dev/pts}"
CHAOS_TICK_TIMEOUT_SECONDS=180
INBOX_DIR="$SIM_DIR/inbox"
GH_TIMEOUT_SECONDS=15

die_usage() {
    echo "Usage: sim $1" >&2
    exit 1
}

die_state() {
    echo "$1" >&2
    exit 2
}

# --- Dates ---------------------------------------------------------------

is_valid_date() {
    [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] &&
        [ "$(date -u -d "$1" +%F 2>/dev/null)" = "$1" ]
}

clock_time() {
    date -d "@$1" +%H:%M
}

date_of_epoch() {
    date -d "@$1" +%F
}

# Calendar arithmetic runs in UTC, where every day is exactly 24 hours long.
add_days() {
    local base
    base=$(date -u -d "$1" +%s)
    date -u -d "@$((base + $2 * SECONDS_PER_DAY))" +%F
}

week_start() {
    local weekday
    weekday=$(date -u -d "$TODAY" +%u)
    add_days "$TODAY" "$((1 - weekday))"
}

is_dayoff() {
    [ -f "$DAYOFF_FILE" ] && grep -qx "$1" "$DAYOFF_FILE"
}

# --- Session state ------------------------------------------------------

# The session file holds: <start epoch> <paused seconds> <pause start epoch, 0 if running>
load_session() {
    [ -f "$SESSION_FILE" ] || return 1
    read -r SESSION_START SESSION_PAUSED SESSION_PAUSE_START <"$SESSION_FILE"
}

save_session() {
    printf '%s %s %s\n' "$1" "$2" "$3" >"$SESSION_FILE.tmp" &&
        mv "$SESSION_FILE.tmp" "$SESSION_FILE" ||
        die_state "Cannot write $SESSION_FILE"
}

# Prints the worked seconds of the loaded session up to the epoch in $1.
session_worked_seconds() {
    local paused=$SESSION_PAUSED
    # An interrupted session is measured up to its last heartbeat, which can be
    # earlier than the pause start.
    if [ "$SESSION_PAUSE_START" -gt 0 ] && [ "$1" -ge "$SESSION_PAUSE_START" ]; then
        paused=$((paused + $1 - SESSION_PAUSE_START))
    fi
    echo "$(($1 - SESSION_START - paused))"
}

# --- Heartbeat ----------------------------------------------------------

# The heartbeat file holds the epoch of the last activity: terminal input or a sim command.
# Takes an optional epoch; the default is now.
write_heartbeat() {
    echo "${1:-$(date +%s)}" >"$HEARTBEAT_FILE.tmp" && mv "$HEARTBEAT_FILE.tmp" "$HEARTBEAT_FILE"
}

# Prints the latest input time of the user's terminals, or 0 if there is none.
# The access time of a terminal device changes when someone types in it, as in the IDLE column of w.
last_terminal_input() {
    local uid
    uid=$(id -u)
    find "$PTS_DIR" -maxdepth 1 -user "$uid" ! -name ptmx -printf '%A@\n' 2>/dev/null |
        awk '{ t = int($1); if (t > max) max = t } END { print max + 0 }'
}

# Random incidents start from the heartbeat, so no second background process is needed.
chaos_tick() {
    local chaos_bin
    chaos_bin="$(dirname "$0")/chaos"
    [ -x "$chaos_bin" ] || return 0
    load_session || return 0
    [ "$SESSION_PAUSE_START" -eq 0 ] || return 0
    timeout "$CHAOS_TICK_TIMEOUT_SECONDS" "$chaos_bin" __tick \
        "$(session_worked_seconds "$(date +%s)")" >/dev/null 2>&1
}

# Each beat moves the heartbeat to the latest activity, never back and never past now.
# After IDLE_CLOSE_SECONDS without activity, the loop closes the session itself and exits.
heartbeat_loop() {
    IN_HEARTBEAT_LOOP=1
    local now activity last_beat
    while [ -f "$SESSION_FILE" ]; do
        now=$(date +%s)
        activity=$(last_terminal_input)
        last_beat=$(cat "$HEARTBEAT_FILE" 2>/dev/null)
        [[ $last_beat =~ ^[0-9]+$ ]] || last_beat=$now
        [ "$activity" -gt "$last_beat" ] || activity=$last_beat
        [ "$activity" -le "$now" ] || activity=$now
        write_heartbeat "$activity"
        if [ $((now - activity)) -gt "$IDLE_CLOSE_SECONDS" ]; then
            load_session && close_interrupted_session >/dev/null
            break
        fi
        chaos_tick
        sleep "$HEARTBEAT_SECONDS"
    done
}

# The command line is checked because a new process can reuse an old PID.
heartbeat_alive() {
    local pid
    [ -s "$HEARTBEAT_PID_FILE" ] || return 1
    read -r pid <"$HEARTBEAT_PID_FILE"
    [[ $pid =~ ^[0-9]+$ ]] || return 1
    tr '\0' ' ' 2>/dev/null <"/proc/$pid/cmdline" | grep -q -- ' __heartbeat '
}

# setsid detaches the process from the terminal, so closing the terminal does not stop it.
start_heartbeat() {
    local attempt
    write_heartbeat || die_state "Cannot write $HEARTBEAT_FILE"
    setsid "$0" __heartbeat </dev/null >/dev/null 2>&1 &
    echo "$!" >"$HEARTBEAT_PID_FILE" || die_state "Cannot write $HEARTBEAT_PID_FILE"
    for attempt in {1..50}; do
        heartbeat_alive && return 0
        sleep 0.02
    done
}

# setsid makes the heartbeat a process group leader; the group also holds its sleep.
# The loop does not kill itself when it closes an idle session.
stop_heartbeat() {
    if [ -z "${IN_HEARTBEAT_LOOP:-}" ] && heartbeat_alive; then
        kill -- "-$(cat "$HEARTBEAT_PID_FILE")" 2>/dev/null
    fi
    rm -f "$HEARTBEAT_FILE" "$HEARTBEAT_FILE.tmp" "$HEARTBEAT_PID_FILE"
}

# A session without a heartbeat file was started by an older sim and is not tracked.
session_interrupted() {
    [ -s "$HEARTBEAT_FILE" ] && ! heartbeat_alive
}

# Prints the epoch up to which the loaded session counts as worked.
session_end_epoch() {
    if session_interrupted; then
        cat "$HEARTBEAT_FILE"
    else
        date +%s
    fi
}

# Writes the loaded session to the worklog and clears it: <end epoch> <minutes> <note>
save_to_worklog() {
    if [ ! -s "$WORKLOG_FILE" ]; then
        echo "$WORKLOG_HEADER" >"$WORKLOG_FILE" || die_state "Cannot write $WORKLOG_FILE"
    fi
    printf '%s,%s,%s,%s,%s\n' "$(date_of_epoch "$SESSION_START")" "$(clock_time "$SESSION_START")" \
        "$(clock_time "$1")" "$2" "$(csv_escape "$3")" >>"$WORKLOG_FILE" ||
        die_state "Cannot write $WORKLOG_FILE"

    stop_heartbeat
    rm -f "$SESSION_FILE"
}

# Closes the loaded session at its last heartbeat. Takes an optional note.
close_interrupted_session() {
    local last_beat minutes
    last_beat=$(cat "$HEARTBEAT_FILE")
    minutes=$(($(session_worked_seconds "$last_beat") / 60))
    save_to_worklog "$last_beat" "$minutes" "${1:-}"
    echo "Session was interrupted. Saved until $(clock_time "$last_beat"): $minutes min"
}

# Closes the session if it had no activity for IDLE_CLOSE_SECONDS. This also covers
# a heartbeat that died long ago. A session without a heartbeat file is not tracked.
close_idle_session() {
    local last_beat
    load_session || return 0
    [ -s "$HEARTBEAT_FILE" ] || return 0
    last_beat=$(cat "$HEARTBEAT_FILE")
    [[ $last_beat =~ ^[0-9]+$ ]] || return 0
    [ $(($(date +%s) - last_beat)) -gt "$IDLE_CLOSE_SECONDS" ] || return 0
    close_interrupted_session >/dev/null
    echo "Session closed after $((IDLE_CLOSE_SECONDS / 60)) min without activity." \
        "Saved until $(clock_time "$last_beat") on $(date_of_epoch "$last_beat")"
}

# A sim command is activity, but only for a session whose heartbeat is still running:
# an interrupted session keeps its last heartbeat as the end.
record_activity() {
    load_session && heartbeat_alive && write_heartbeat
    return 0
}

# Minutes worked on a date. A session belongs to the date on which it started.
minutes_on() {
    local day=$1 total=0
    if [ -f "$WORKLOG_FILE" ]; then
        # The note is the last column, so commas inside it cannot shift these fields.
        total=$(awk -F, -v day="$day" '$1 == day { sum += $4 } END { print sum + 0 }' "$WORKLOG_FILE")
    fi
    if load_session && [ "$(date_of_epoch "$SESSION_START")" = "$day" ]; then
        total=$((total + $(session_worked_seconds "$(session_end_epoch)") / 60))
    fi
    echo "$total"
}

to_hours() {
    awk -v minutes="$1" 'BEGIN { printf "%.1f", minutes / 60 }'
}

csv_escape() {
    local value=$1 doubled_quote='""'
    value=${value//$'\r'/ }
    value=${value//$'\n'/ }
    case $value in
        *,* | *\"*)
            value=${value//\"/$doubled_quote}
            value="\"$value\""
            ;;
    esac
    printf '%s' "$value"
}

# --- Simulation calendar ------------------------------------------------

load_config() {
    [ -f "$CONFIG_FILE" ] || return 1
    START_DATE=$(sed -n 's/^START_DATE=//p' "$CONFIG_FILE" | head -n 1)
    is_valid_date "$START_DATE"
}

# --- Simulation clock ----------------------------------------------------
#
# The simulation has its own calendar of working days (Monday to Friday). It moves
# one day when work starts on a new real date (sim start or sim work), or when a
# real date is marked as a day off. More sessions on the same real date stay on the
# same simulation day, and days without work or a day off do not move the clock.

# Builds the simulation day list from existing data when the file does not exist yet.
# Session dates become work days and past days off become days off, from the start
# date through today. A date that is both counts as a day off. No existing file is changed.
ensure_simdays() {
    [ -f "$SIMDAYS_FILE" ] && return 0
    {
        if [ -f "$WORKLOG_FILE" ]; then
            awk -F, 'NR > 1 && $1 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/ { print $1, "work" }' "$WORKLOG_FILE"
        fi
        if load_session; then
            echo "$(date_of_epoch "$SESSION_START") work"
        fi
        if [ -f "$DAYOFF_FILE" ]; then
            awk '{ print $1, "off" }' "$DAYOFF_FILE"
        fi
    } | awk -v first="$START_DATE" -v last="$TODAY" '
        $1 >= first && $1 <= last && (!($1 in kind) || $2 == "off") { kind[$1] = $2 }
        END { for (day in kind) print day, kind[day] }' | sort >"$SIMDAYS_FILE.tmp" &&
        mv "$SIMDAYS_FILE.tmp" "$SIMDAYS_FILE" ||
        die_state "Cannot write $SIMDAYS_FILE"
}

is_simday() {
    grep -q "^$1 " "$SIMDAYS_FILE"
}

add_simday() {
    echo "$1 $2" >>"$SIMDAYS_FILE" || die_state "Cannot write $SIMDAYS_FILE"
}

# Adds days off that have arrived (today or earlier) and are not simulation days yet.
sync_dayoffs() {
    local day
    [ -f "$DAYOFF_FILE" ] || return 0
    while read -r day; do
        if [[ ! $day < $START_DATE ]] && [[ ! $day > $TODAY ]] && ! is_simday "$day"; then
            add_simday "$day" off
        fi
    done <"$DAYOFF_FILE"
}

# Prepares the clock before a command. Does nothing before sim init.
update_clock() {
    load_config || return 0
    ensure_simdays
    sync_dayoffs
}

# Makes today a work day of the simulation, unless it already is a simulation day.
mark_work_day() {
    load_config || return 0
    ensure_simdays
    is_simday "$TODAY" || add_simday "$TODAY" work
}

simulation_days_total() {
    grep -c . "$SIMDAYS_FILE"
}

# Prints the simulation day number of a real date, or nothing if it is not one.
simday_of() {
    grep -n "^$1 " "$SIMDAYS_FILE" | head -n 1 | cut -d: -f1
}

# Prints the calendar date of simulation day $1. Day 1 is the first Monday on or
# after the start date, and the simulation calendar has only Monday to Friday.
sim_date() {
    local monday weekday
    weekday=$(date -u -d "$START_DATE" +%u)
    monday=$(add_days "$START_DATE" "$(((8 - weekday) % 7))")
    add_days "$monday" "$((($1 - 1) / 5 * 7 + ($1 - 1) % 5))"
}

# Minutes worked on the real dates of simulation sprint $1.
minutes_in_sprint() {
    local first total=0 day
    first=$((($1 - 1) * DAYS_PER_SPRINT + 1))
    while read -r day _; do
        total=$((total + $(minutes_on "$day")))
    done < <(sed -n "${first},$((first + DAYS_PER_SPRINT - 1))p" "$SIMDAYS_FILE")
    echo "$total"
}

commits_since() {
    git log --oneline --no-decorate --since="$(date -d "@$1" '+%F %T')" 2>/dev/null
}

# Prints open GitHub issues as "#number title". Fails if gh cannot provide them.
open_issues() {
    command -v gh >/dev/null 2>&1 || return 1
    timeout "$GH_TIMEOUT_SECONDS" gh issue list --state open --limit 100 \
        --json number,title --jq '.[] | "#\(.number) \(.title)"' 2>/dev/null
}

open_tickets() {
    local root file status
    # A successful empty list means no open issues, so only a failure falls back to files.
    open_issues && return 0
    root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
    for file in "$root"/tickets/OPS-*.md; do
        [ -f "$file" ] || continue
        status=$(sed -n 's/^[[:space:]]*Status:[[:space:]]*//p' "$file" | head -n 1 | tr -d '\r' |
            sed 's/[[:space:]]*$//')
        if [ "$status" != "Done" ]; then
            echo "tickets/${file##*/}"
        fi
    done | sort -V
}

print_list() {
    if [ -n "$2" ]; then
        echo "$1"
        echo "$2"
    else
        echo "$1 none"
    fi
}

# --- Inbox --------------------------------------------------------------

# The file name starts with the delivery epoch, so delivery needs no running process.
new_messages() {
    local file name now
    now=$(date +%s)
    for file in "$INBOX_DIR"/*.msg; do
        [ -f "$file" ] || continue
        name=${file##*/}
        if [ "${name%%-*}" -le "$now" ]; then
            echo "$file"
        fi
    done | sort
}

count_new_messages() {
    new_messages | grep -c .
}

# --- Commands -----------------------------------------------------------

cmd_init() {
    [ $# -eq 0 ] || die_usage "init"
    local input start_date
    read -r -p "Simulation start date (YYYY-MM-DD) [$TODAY]: " input
    start_date=${input:-$TODAY}
    is_valid_date "$start_date" || die_usage "init (the date must be a real YYYY-MM-DD date)"
    echo "START_DATE=$start_date" >"$CONFIG_FILE" || die_state "Cannot write $CONFIG_FILE"
    # A new start date starts the clock again. The old day list is kept as a copy.
    if [ -f "$SIMDAYS_FILE" ]; then
        mv "$SIMDAYS_FILE" "$SIMDAYS_FILE.bak" || die_state "Cannot move $SIMDAYS_FILE"
    fi
    echo "Simulation start date: $start_date"
}

start_session() {
    local now
    now=$(date +%s)
    save_session "$now" 0 0
    start_heartbeat
    mark_work_day
    echo "Session started at $(clock_time "$now")"
}

cmd_start() {
    [ $# -eq 0 ] || die_usage "start"
    if load_session; then
        session_interrupted || die_state "Session already running since $(clock_time "$SESSION_START")"
        close_interrupted_session
    fi
    start_session
}

cmd_work() {
    [ $# -eq 0 ] || die_usage "work"
    local unread answer
    if load_session && session_interrupted; then
        close_interrupted_session
    elif load_session; then
        if [ "$SESSION_PAUSE_START" -gt 0 ]; then
            echo "Work day in progress, paused since $(clock_time "$SESSION_PAUSE_START"). Run: sim resume"
        else
            echo "Work day in progress since $(clock_time "$SESSION_START")"
        fi
        echo "Worked today: $(to_hours "$(minutes_on "$TODAY")") h ($(minutes_on "$TODAY") min)"
        unread=$(count_new_messages)
        if [ "$unread" -gt 0 ]; then
            echo "Inbox: $unread new messages (sim inbox)"
        else
            echo "Inbox: no new messages"
        fi
        return 0
    fi

    if ! read -r -p "Start work day? [Y/n] " answer; then
        echo
        echo "Work day not started"
        return 0
    fi
    case $answer in
        "" | [Yy] | [Yy][Ee][Ss]) ;;
        *)
            echo "Work day not started"
            return 0
            ;;
    esac

    start_session
    echo
    if load_config; then
        cmd_standup
    else
        echo "Simulation is not initialized, so there is no standup. Run: sim init"
    fi
    echo
    cmd_inbox
}

cmd_stop() {
    [ $# -le 1 ] || die_usage 'stop ["note"]'
    load_session || die_state "No active session"
    if session_interrupted; then
        close_interrupted_session "${1:-}"
        return 0
    fi
    local now minutes
    now=$(date +%s)
    minutes=$(($(session_worked_seconds "$now") / 60))
    save_to_worklog "$now" "$minutes" "${1:-}"
    echo "Session saved: $minutes min"
}

cmd_pause() {
    [ $# -eq 0 ] || die_usage "pause"
    load_session || die_state "No active session"
    if [ "$SESSION_PAUSE_START" -gt 0 ]; then
        die_state "Session already paused since $(clock_time "$SESSION_PAUSE_START")"
    fi
    local now
    now=$(date +%s)
    save_session "$SESSION_START" "$SESSION_PAUSED" "$now"
    echo "Session paused at $(clock_time "$now")"
}

cmd_resume() {
    [ $# -eq 0 ] || die_usage "resume"
    load_session || die_state "No active session"
    if [ "$SESSION_PAUSE_START" -eq 0 ]; then
        die_state "Session is not paused"
    fi
    local now pause_seconds
    now=$(date +%s)
    pause_seconds=$((now - SESSION_PAUSE_START))
    save_session "$SESSION_START" "$((SESSION_PAUSED + pause_seconds))" 0
    echo "Session resumed after $((pause_seconds / 60)) min pause"
}

cmd_status() {
    [ $# -eq 0 ] || die_usage "status"
    if load_session && session_interrupted; then
        echo "Session interrupted (the heartbeat stopped). Run: sim stop"
    elif load_session; then
        local worked
        worked=$(($(session_worked_seconds "$(date +%s)") / 60))
        if [ "$SESSION_PAUSE_START" -gt 0 ]; then
            echo "Session: paused since $(clock_time "$SESSION_PAUSE_START"), started $(clock_time "$SESSION_START"), $worked min worked"
        else
            echo "Session: running since $(clock_time "$SESSION_START"), $worked min worked"
        fi
    else
        echo "Session: none"
    fi
    echo "Worked today: $(minutes_on "$TODAY") min"
}

notify_windows() {
    powershell.exe -NoProfile -NonInteractive -Command "
        Add-Type -AssemblyName System.Windows.Forms, System.Drawing;
        \$icon = New-Object System.Windows.Forms.NotifyIcon;
        \$icon.Icon = [System.Drawing.SystemIcons]::Information;
        \$icon.Visible = \$true;
        \$icon.ShowBalloonTip(10000, 'FinSim focus', '$1', 'Info');
        [console]::Beep(880, 300);
        [console]::Beep(880, 300);
        [console]::Beep(1175, 500);
        Start-Sleep -Seconds 5;
        \$icon.Dispose()" >/dev/null 2>&1
}

cmd_focus() {
    [ $# -le 1 ] || die_usage "focus [minutes]"
    local minutes=${1:-$DEFAULT_FOCUS_MINUTES}
    [[ $minutes =~ ^[1-9][0-9]*$ ]] || die_usage "focus [minutes] (minutes must be a positive integer)"

    local seconds=$((minutes * 60))
    echo "Focus started: $minutes min, until $(clock_time "$(($(date +%s) + seconds))"). Press Ctrl+C to cancel."
    sleep "$seconds"
    if command -v powershell.exe >/dev/null 2>&1; then
        notify_windows "Focus finished: $minutes min"
        echo "Focus finished: $minutes min"
    else
        printf '\a'
        echo "Focus session finished ($minutes min)"
    fi
}

cmd_dayoff() {
    [ $# -le 1 ] || die_usage "dayoff [YYYY-MM-DD]"
    local day=${1:-$TODAY}
    is_valid_date "$day" || die_usage "dayoff [YYYY-MM-DD]"
    if is_dayoff "$day"; then
        echo "Day off already marked: $day"
        return 0
    fi
    echo "$day" >>"$DAYOFF_FILE" || die_state "Cannot write $DAYOFF_FILE"
    # A day off that has arrived takes a simulation day now; a future one when it arrives.
    update_clock
    echo "Day off marked: $day"
}

report_today() {
    local minutes
    minutes=$(minutes_on "$TODAY")
    echo "Report for $TODAY ($(date -u -d "$TODAY" +%A))"
    echo "Total: $(to_hours "$minutes") h ($minutes min)"
}

report_week() {
    local monday offset day minutes label total=0
    monday=$(week_start)
    echo "Week $monday .. $(add_days "$monday" 6)"
    for offset in 0 1 2 3 4 5 6; do
        day=$(add_days "$monday" "$offset")
        minutes=$(minutes_on "$day")
        total=$((total + minutes))
        label=""
        if is_dayoff "$day"; then
            label=" (day off)"
        fi
        printf '%s %s %5s h%s\n' "$(date -u -d "$day" +%a)" "$day" "$(to_hours "$minutes")" "$label"
    done
    echo "Total: $(to_hours "$total") h ($total min)"
}

cmd_report() {
    [ $# -le 1 ] || die_usage "report [today|week]"
    case ${1:-today} in
        today) report_today ;;
        week) report_week ;;
        *) die_usage "report [today|week]" ;;
    esac
}

cmd_standup() {
    [ $# -eq 0 ] || die_usage "standup"
    load_config || die_state "Simulation is not initialized. Run: sim init"

    local since day sprint sprint_day
    if [ -s "$STANDUP_FILE" ]; then
        since=$(cat "$STANDUP_FILE")
    else
        since=$(date -d "$START_DATE" +%s)
    fi

    # Today is the current simulation day once work has started on it. Before that,
    # the standup shows the last simulation day.
    local started=1 date_line kind sim_today
    update_clock
    day=$(simday_of "$TODAY")
    if [ -z "$day" ]; then
        started=0
        day=$(simulation_days_total)
    fi
    sprint=1
    sprint_day=0
    date_line="not started"
    if [ "$day" -gt 0 ]; then
        sprint=$(((day - 1) / DAYS_PER_SPRINT + 1))
        sprint_day=$(((day - 1) % DAYS_PER_SPRINT + 1))
        sim_today=$(sim_date "$day")
        date_line="$sim_today ($(date -u -d "$sim_today" +%A))"
        kind=$(sed -n "${day}p" "$SIMDAYS_FILE" | cut -d' ' -f2)
        if [ "$kind" = "off" ]; then
            date_line="$date_line (day off)"
        fi
    fi

    echo "=== STANDUP ==="
    echo "Date: $date_line"
    echo "Real date: $TODAY"
    echo "Simulation day: $day"
    echo "Sprint $sprint, day $sprint_day"
    echo "Hours today: $(to_hours "$(minutes_on "$TODAY")") | This sprint: $(to_hours "$(minutes_in_sprint "$sprint")")"
    if [ "$started" -eq 0 ]; then
        echo "Work day not started. Run: sim work"
    fi
    print_list "Commits since last standup:" "$(commits_since "$since")"
    print_list "Open tickets:" "$(open_tickets)"
    echo "Unread messages: $(count_new_messages)"
    echo "==============="

    date +%s >"$STANDUP_FILE" || die_state "Cannot write $STANDUP_FILE"
}

cmd_inbox() {
    [ $# -eq 0 ] || die_usage "inbox"
    local messages file
    messages=$(new_messages)
    if [ -z "$messages" ]; then
        echo "No new messages"
        return 0
    fi
    mkdir -p "$INBOX_DIR/read" || die_state "Cannot create $INBOX_DIR/read"
    while IFS= read -r file; do
        cat "$file"
        mv "$file" "$INBOX_DIR/read/" || die_state "Cannot move $file"
    done <<<"$messages"
}

cmd_ticket() {
    [ $# -eq 1 ] && [[ $1 =~ ^[1-9][0-9]*$ ]] || die_usage "ticket <number>"
    command -v gh >/dev/null 2>&1 || die_state "gh is not available"
    gh issue view "$1" || die_state "Cannot show issue $1"
}

print_help() {
    cat <<'EOF'
sim - work-time tracker for the FinSim simulation

Usage: sim <command> [arguments]

Commands:
  init                  Set the simulation start date
  work                  Start the work day, or show how it is going
  start                 Start a work session
  stop ["note"]         Stop the session and save it to the worklog
  pause                 Pause the session; paused time is not counted
  resume                Resume a paused session
  status                Show the session state and minutes worked today
  focus [minutes]       Run a focus timer (default: 50 minutes)
  dayoff [YYYY-MM-DD]   Mark a day off (default: today)
  report [today|week]   Show hours for today or for this week (default: today)
  standup               Print a standup block ready to paste into chat
  inbox                 Show new chat messages and mark them as read
  ticket <number>       Show a GitHub issue
  help                  Show this help

Exit codes: 0 success, 1 wrong usage, 2 state error
EOF
}

cmd_help() {
    [ $# -eq 0 ] || die_usage "help"
    print_help
}

main() {
    if [ $# -eq 0 ]; then
        print_help >&2
        exit 1
    fi

    mkdir -p "$SIM_DIR" || die_state "Cannot create $SIM_DIR"
    # SIM_TEST_TODAY replaces the real date in tests of the simulation clock.
    TODAY=${SIM_TEST_TODAY:-$(date +%F)}

    local command=$1 unread
    shift
    if [ "$command" != "__heartbeat" ]; then
        close_idle_session
        record_activity
        update_clock
        unread=$(count_new_messages)
        # sim work prints its own inbox line.
        if [ "$unread" -gt 0 ] && [ "$command" != "work" ]; then
            echo "You have $unread new messages (sim inbox)"
        fi
    fi
    case $command in
        init | work | start | stop | pause | resume | status | focus | dayoff | report | standup | inbox | ticket | help)
            "cmd_$command" "$@"
            ;;
        __heartbeat)
            heartbeat_loop
            ;;
        *)
            print_help >&2
            exit 1
            ;;
    esac
}

main "$@"
