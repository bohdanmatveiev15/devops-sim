# Test-only values for the local FinSim environment. Copy to .env.staging before starting.

# Public nginx port
NGINX_PORT=8081

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finsim_staging
POSTGRES_USER=finsim
POSTGRES_PASSWORD=staging_test_only

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_QUEUE=payments:queue

# Application logging
LOG_LEVEL=INFO

# Load generator
API_URL=http://nginx
ENABLED=true
RPS=1
