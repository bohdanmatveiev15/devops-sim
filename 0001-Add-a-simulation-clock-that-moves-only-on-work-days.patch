-# Counts working days from the start date through today, without days off.
+# --- Simulation clock ----------------------------------------------------
+#
+# The simulation has its own calendar. A real date becomes the next simulation
+# day only when you work on it (sim start or sim standup). Days without work do
+# not move the clock, so a week away is not a week lost.
+
+is_weekday() {
+    [ "$(date -u -d "$1" +%u)" -lt 6 ]
+}
+
+# Builds the simulation day list from the worklog when the file does not exist yet.
+# Only dates from the start date on are used, and days off are skipped.
+ensure_simdays() {
+    [ -f "$SIMDAYS_FILE" ] && return 0
+    {
+        if [ -f "$WORKLOG_FILE" ]; then
+            awk -F, 'NR > 1 && $1 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/ { print $1 }' "$WORKLOG_FILE"
+        fi
+        if load_session; then
+            date_of_epoch "$SESSION_START"
+        fi
+    } | sort -u | while read -r day; do
+        if [[ ! $day < $START_DATE ]] && ! is_dayoff "$day"; then
+            echo "$day"
+        fi
+    done >"$SIMDAYS_FILE.tmp" && mv "$SIMDAYS_FILE.tmp" "$SIMDAYS_FILE" ||
+        die_state "Cannot write $SIMDAYS_FILE"
+}
+
+# Makes today a simulation day, unless it already is one or is a day off.
+mark_sim_day() {
+    load_config || return 0
+    ensure_simdays
+    is_dayoff "$TODAY" && return 0
+    grep -qx "$TODAY" "$SIMDAYS_FILE" && return 0
+    echo "$TODAY" >>"$SIMDAYS_FILE" || die_state "Cannot write $SIMDAYS_FILE"
+}
+
 simulation_day() {
-    local first last day timestamp count=0
-    local -a dayoffs=()
-    first=$(($(date -u -d "$START_DATE" +%s) / SECONDS_PER_DAY))
-    last=$(($(date -u -d "$TODAY" +%s) / SECONDS_PER_DAY))
-
-    if [ -s "$DAYOFF_FILE" ]; then
-        while read -r timestamp; do
-            dayoffs[$((timestamp / SECONDS_PER_DAY))]=1
-        done < <(date -u -f "$DAYOFF_FILE" +%s)
-    fi
+    ensure_simdays
+    grep -c . "$SIMDAYS_FILE"
+}
 
-    for ((day = first; day <= last; day++)); do
-        # Day 0 of the epoch was a Thursday, so this gives 0 for Monday.
-        if [ $(((day + 3) % 7)) -lt 5 ] && [ -z "${dayoffs[$day]}" ]; then
+# Prints the calendar date of simulation day $1: the start date plus $1 - 1
+# working days. Weekends never appear in the simulation calendar.
+sim_date() {
+    local day=$START_DATE count=1
+    while ! is_weekday "$day"; do
+        day=$(add_days "$day" 1)
+    done
+    while [ "$count" -lt "$1" ]; do
+        day=$(add_days "$day" 1)
+        if is_weekday "$day"; then
             count=$((count + 1))
         fi
     done
-    echo "$count"
+    echo "$day"
+}
+
+# Minutes worked in simulation sprint $1.
+minutes_in_sprint() {
+    local first total=0 day
+    first=$((($1 - 1) * DAYS_PER_SPRINT + 1))
+    while read -r day; do
+        total=$((total + $(minutes_on "$day")))
+    done < <(sed -n "${first},$((first + DAYS_PER_SPRINT - 1))p" "$SIMDAYS_FILE")
+    echo "$total"
 }
 
